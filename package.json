{
  "name": "jev-state",
  "version": "0.1.0",
  "description": "Turn raw app and game state into something Jev reads well: numbers to labels, timestamps to relative time, lists pruned, candidates made pickable.",
  "license": "MIT",
  "author": "Suranjay Kumar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suranjaychandra/jev-state.git"
  },
  "homepage": "https://github.com/suranjaychandra/jev-state#readme",
  "bugs": "https://github.com/suranjaychandra/jev-state/issues",
  "keywords": [
    "jev",
    "typesafe",
    "typesafe-ai",
    "system-one",
    "ai",
    "state",
    "npc",
    "game-ai",
    "prompt"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "tsx examples/npc.ts",
    "bench": "tsx bench/run.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "compare": "tsx examples/compare.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@typesafe-ai/sdk": "^0.6.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
